---
import { profile } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <p class="footer-kicker">Built around evidence, not noise.</p>
      <p class="footer-copy">Charlie Mai · {profile.location}</p>
    </div>
    <div class="footer-links">
      <a href={"mailto:" + profile.email}>{profile.email}</a>
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <p class="footer-meta">© {year} Charlie Mai</p>
  </div>
</footer>
