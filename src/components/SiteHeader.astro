---
import { profile } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { label: "Home", href: "/" },
  { label: "CV", href: "/cv/" },
  { label: "Projects", href: "/projects/" },
  { label: "Writing", href: "/writing/" },
  { label: "Lab", href: "/lab/" },
  { label: "Learning", href: "/learning/" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Charlie Mai home">
      <span class="brand-mark">CM</span>
      <span>
        <strong>Charlie Mai</strong>
        <small>Cloud / DevOps / AI</small>
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      {
        navItems.map((item) => {
          const normalised = item.href.replace(/\/$/, "") || "/";
          const active = currentPath === normalised;
          return (
            <a
              class:list={["nav-link", active && "is-active"]}
              href={item.href}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <a class="header-contact" href={"mailto:" + profile.email}>Let's talk <span aria-hidden="true">↗</span></a>
  </div>
</header>
