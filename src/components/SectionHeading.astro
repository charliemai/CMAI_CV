---
export interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  id?: string;
}

const { eyebrow, title, intro, id } = Astro.props;
---

<div class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {intro && <p class="section-intro">{intro}</p>}
</div>
