---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { projects } from "../data/site";
---

<BaseLayout title="Projects | Charlie Mai" description="Selected products, civic technology, AI experiments, and automation utilities by Charlie Mai.">
  <section class="page-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Evidence in the shape of a project.</h1>
    <p>
      These projects are not a catalogue of every idea. They are a compact set of products and
      experiments that show how I move from a human need to a system that can be used and improved.
    </p>
  </section>

  <section aria-labelledby="project-grid-title">
    <SectionHeading
      eyebrow="Portfolio"
      title="Build, operate, learn."
      intro="Each case study states the job, the technical shape, and the signal it adds to the larger career story."
      id="project-grid-title"
    />
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
