---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { projects } from "../data/site";
---

<BaseLayout
  title="Projects | Charlie Mai"
  description="Selected Cloud, DevOps, civic technology and applied AI projects by Charlie Mai, with ownership, engineering decisions and evidence."
>
  <section class="page-intro">
    <p class="eyebrow">Selected work</p>
    <h1>Evidence in the shape of a project.</h1>
    <p>
      These projects are not a catalogue of every idea. They show how I move from a human need to a system that can be used, investigated and improved.
    </p>
  </section>

  <section aria-labelledby="project-grid-title">
    <SectionHeading
      eyebrow="Portfolio"
      title="Build, operate, learn."
      intro="Each case study states the job, technical shape, trust boundary, testing approach, evidence and honest current status."
      id="project-grid-title"
    />
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
