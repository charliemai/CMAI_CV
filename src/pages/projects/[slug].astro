---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={project.title + " | Charlie Mai"} description={project.summary} image={project.image}>
  <section class="detail-hero">
    <div>
      <p class="eyebrow">{project.eyebrow} · {project.status}</p>
      <h1>{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <div class="button-row">
        <a class="button secondary" href="/projects/">Back to projects</a>
        {project.href && <a class="button" href={project.href} target="_blank" rel="noreferrer">Open related product ↗</a>}
      </div>
    </div>
    <div class="detail-art">
      <img src={project.image} alt="" />
    </div>
  </section>

  <section class="detail-layout">
    <aside class="detail-meta" aria-label="Project metadata">
      <div class="detail-meta-block">
        <span>Problem</span>
        <strong>{project.problem}</strong>
      </div>
      <div class="detail-meta-block">
        <span>Evidence</span>
        <strong>{project.evidence}</strong>
      </div>
      <div class="detail-meta-block">
        <span>Role</span>
        <strong>{project.role}</strong>
      </div>
      <div class="detail-meta-block">
        <span>Stack</span>
        <div class="tag-list">
          {project.stack.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    </aside>
    <div>
      <h2>What this shows</h2>
      <ul>
        {project.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
