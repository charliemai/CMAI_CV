---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  certifications,
  education,
  experience,
  languages,
  metrics,
  profile,
  skillGroups,
} from "../data/site";
---

<BaseLayout
  title="CV | Charlie Mai - Cloud, DevOps & Production Reliability Engineer"
  description="Web CV for Charlie Mai, a Dublin-based Cloud, DevOps and Production Reliability Engineer with AWS CloudFront SME experience."
>
  <section class="page-intro">
    <p class="eyebrow">Curriculum vitae</p>
    <h1>Experience that holds up under pressure.</h1>
    <p>
      Cloud operations, production reliability, distributed systems, incident investigation and practical automation. The formal two-page CV is available as a searchable PDF; this page keeps the evidence readable on the web.
    </p>
    <div class="button-row">
      <a class="button" href={profile.cv}>Download two-page CV <span aria-hidden="true">-&gt;</span></a>
      <a class="button secondary" href={"mailto:" + profile.email}>Contact Charlie</a>
    </div>
  </section>

  <div class="cv-layout">
    <aside class="cv-aside" aria-label="CV summary">
      <div class="aside-block">
        <h2>Current role</h2>
        <p>{profile.currentRole}</p>
        <p>{profile.location}</p>
      </div>
      <div class="aside-block">
        <h2>Target roles</h2>
        <ul>
          {profile.targetRoles.map((role) => <li>{role}</li>)}
        </ul>
      </div>
      <div class="aside-block">
        <h2>Proof</h2>
        <ul>
          {metrics.map((metric) => <li><strong>{metric.value}</strong> - {metric.label}</li>)}
        </ul>
      </div>
      <div class="aside-block">
        <h2>Contact</h2>
        <ul>
          <li><a class="text-link" href={"mailto:" + profile.email}>{profile.email}</a></li>
          <li><a class="text-link" href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">-&gt;</span></a></li>
          <li><a class="text-link" href={profile.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">-&gt;</span></a></li>
          <li><a class="text-link" href={profile.links.portfolio}>cv.cmai.ai <span aria-hidden="true">-&gt;</span></a></li>
        </ul>
      </div>
      <div class="aside-block">
        <h2>Languages</h2>
        <ul>
          {languages.map((language) => <li>{language.name} - {language.level}</li>)}
        </ul>
      </div>
    </aside>

    <div class="cv-main">
      <section aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <div class="timeline">
          {experience.map((role) => (
            <article class="timeline-item">
              <div class="timeline-period">{role.period} - {role.location}</div>
              <h3>{role.position} <span>at {role.company}</span></h3>
              <p class="timeline-summary">{role.summary}</p>
              <ul>
                {role.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="skills-title">
        <h2 id="skills-title">Core capabilities</h2>
        <div class="skill-groups">
          {skillGroups.map((group) => (
            <article class="skill-group">
              <h3>{group.title}</h3>
              <div class="tag-list">
                {group.items.map((item) => <span class="tag">{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="education-title">
        <h2 id="education-title">Education</h2>
        <div class="education-grid">
          {education.map((item) => (
            <article class="education-item">
              <span class="meta-line">{item.period}</span>
              <h3>{item.programme}</h3>
              <p>{item.institution}{item.note ? " - " + item.note : ""}</p>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="certifications-title">
        <h2 id="certifications-title">Certifications and recognition</h2>
        <div class="tag-list">
          {certifications.map((certification) => <span class="tag">{certification}</span>)}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
