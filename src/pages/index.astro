---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { experience, focusAreas, metrics, profile, projects, writing } from "../data/site";

const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const recentExperience = experience.slice(0, 3);
const plannedWriting = writing.slice(0, 2);
---

<BaseLayout
  title="Charlie Mai | Cloud, DevOps & Production Reliability Engineer"
  description="Dublin-based Cloud and DevOps engineer, former AWS CloudFront SME, specialising in production reliability, incident investigation, serverless systems and operational automation."
>
  <section class="hero-grid section" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Dublin - Cloud operations - Production reliability</p>
      <h1 id="hero-title">Cloud, DevOps &amp; <em>Production Reliability</em> Engineer.</h1>
      <p class="hero-subline">
        {profile.currentRole} - Former AWS Cloud Support Engineer II and CloudFront SME - Part-time UCD MSc student
      </p>
      <p class="hero-lede">{profile.summary}</p>
      <div class="button-row">
        <a class="button" href="/cv/">View experience <span aria-hidden="true">-&gt;</span></a>
        <a class="button secondary" href={profile.cv}>Download CV</a>
      </div>
      <ul class="hero-proof" aria-label="Professional focus">
        <li>AWS and serverless operations</li>
        <li>Incident investigation and RCA</li>
        <li>DevOps automation</li>
      </ul>
    </div>

    <aside class="hero-aside" aria-label="Profile and opportunities">
      <div class="hero-image-frame">
        <img src={profile.image} alt="Portrait of Charlie Mai" width="720" height="840" />
      </div>
      <div class="hero-note">
        <strong>Selective opportunities</strong>
        <span>{profile.availability}</span>
      </div>
    </aside>
  </section>

  <section class="section metrics-section" aria-labelledby="proof-title">
    <SectionHeading
      eyebrow="Proof points"
      title="Evidence from building, delivering and operating systems."
      intro="The strongest signal is a pattern: production pressure, measurable delivery and practical automation that people can operate."
      id="proof-title"
    />
    <div class="metric-grid">
      {metrics.map((metric) => (
        <div class="metric">
          <strong class="metric-value">{metric.value}</strong>
          <span class="metric-label">{metric.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section split-section" aria-labelledby="focus-title">
    <div>
      <SectionHeading
        eyebrow="Core capabilities"
        title="Technical depth with an operator's mindset."
        intro="I work where a complex system, a real user problem and an accountable next decision meet."
        id="focus-title"
      />
      <a class="text-link" href="/cv/">View the full experience and skills <span aria-hidden="true">-&gt;</span></a>
    </div>
    <div class="focus-list">
      {focusAreas.map((area) => (
        <article class="focus-item">
          <h3>{area.title}</h3>
          <p>{area.description}</p>
          <div class="tag-list">
            {area.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <SectionHeading
      eyebrow="Selected work"
      title="Three projects with a reason to exist."
      intro="Case studies show the human job, the technical shape, the trust boundary and the evidence - not just a stack list."
      id="projects-title"
    />
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="button-row">
      <a class="button secondary" href="/projects/">Browse all projects <span aria-hidden="true">-&gt;</span></a>
    </div>
  </section>

  <section class="section split-section" aria-labelledby="career-title">
    <div>
      <SectionHeading
        eyebrow="Career signal"
        title="Build systems -> deliver systems -> operate them under pressure."
        intro="The recent chapter combines production support, AWS expertise, CDN delivery, technical coordination and applied AI study."
        id="career-title"
      />
      <a class="text-link" href="/learning/">See the learning thread <span aria-hidden="true">-&gt;</span></a>
    </div>
    <div class="mini-timeline">
      {recentExperience.map((role) => (
        <article class="mini-timeline-item">
          <time>{role.period}</time>
          <h3>{role.position} - {role.company}</h3>
          <p>{role.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <SectionHeading
      eyebrow="Writing in development"
      title="A secondary layer, kept honest."
      intro="These are planned notes, not published articles. The work comes first; writing will follow when there is useful material to share."
      id="writing-title"
    />
    <div class="writing-list">
      {plannedWriting.map((post) => (
        <article class="writing-item">
          <time>{post.date}</time>
          <div>
            <span class="tag">{post.status}</span>
            <h3>{post.title}</h3>
            <p>{post.summary}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="button-row">
      <a class="button secondary" href="/writing/">See writing status <span aria-hidden="true">-&gt;</span></a>
    </div>
  </section>
</BaseLayout>
